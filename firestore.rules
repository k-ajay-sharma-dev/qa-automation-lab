rules_version = '2';

// QA Automation Lab: each signed-in person can read and write only their own progress, and nothing else exists.
// Paste this into Firebase console → Firestore Database → Rules → Publish (see DEPLOY.md).
// This project belongs to the QA app alone, so no other app's rules need to be kept in this file.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per problem: { entry, updatedAt, syncedAt }
    match /users/{uid}/qaProgress/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['entry', 'updatedAt', 'syncedAt']);
    }

    // Settings, timers and mock-interview history: { value, updatedAt, syncedAt }
    match /users/{uid}/qaState/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'syncedAt']);
    }
  }
}
